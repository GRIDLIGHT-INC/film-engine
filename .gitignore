# Xcode archive and export output — the .ipa is a build artefact, not source
build/

# Session exports from the desktop client — not source
Claude outputs/

# The instrument sidecar runs plugins; its venv is the operator's, not the repo's.
backend/.venv/

# Python bytecode from the sidecar and its workers.
__pycache__/
*.pyc
.neoncore/

