      "mpeg",
      "mpg",
      "mts",
      "mxf",
      "ser",
      "ts",
      "vob",
      "webm",
      "wmv"
    ],
    "output_required": [
      "resolution",
      "frameRate",
      "audioTransfer"
    ],
    "audioTransfer": [
      "Copy",
      "Convert",
      "None"
    ],
    "videoEncoder": [
      "AV1",
      "H264",
      "H265",
      "ProRes",
      "VP9"
    ]
  },
  "accept": {
    "path": "/video/{requestId}/accept",
    "method": "PATCH",
    "returns": [
      "uploadId",
      "urls"
    ]
  },
  "complete": {
    "path": "/video/{requestId}/complete-upload/",
    "method": "PATCH",
    "body": "uploadResults[{partNum,eTag}]"
  },
  "status": {
    "path": "/video/{requestId}/status",
    "method": "GET",
    "statuses": [
      "requested",
      "accepted",
      "initializing",
      "preprocessing",
      "processing",
      "postprocessing",
      "complete",
      "canceling",
      "canceled",
      "failed"
    ],
    "download": "download.url"
  },
  "cancel": {
    "path": "/video/{requestId}",
    "method": "DELETE"
  },
  "model_params": {
