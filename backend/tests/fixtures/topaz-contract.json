  "create": {
    "path": "/video/",
    "method": "POST",
    "required": [
      "source",
      "filters",
      "output"
    ],
    "source_required": [
      "container",
      "size",
      "duration",
      "frameCount",
      "frameRate",
      "resolution"
    ],
    "source_containers": [
      "3gp",
      "avi",
      "dv",
      "flv",
      "m1v",
      "m2t",
      "m2ts",
      "m2v",
      "m4v",
