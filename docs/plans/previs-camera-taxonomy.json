  "plan": {
    "routeNamespace": "previs",
    "modules": [
      {
        "path": "backend/lib/previs-camera.js",
        "status": "built",
        "phase": 0,
        "why": "Pure optics: FOV, framing distance, depth of field, hyperfocal. No DB, no DOM."
      },
      {
        "path": "backend/lib/previs-blocking.js",
        "status": "built",
        "phase": 1,
        "why": "Blocking as data: camera transform, subject placement, the ground plane, and the movement path sampled to keyframes."
      },
      {
        "path": "backend/routes/previs.js",
        "status": "built",
        "phase": 2,
        "why": "handlePrevis(req, res, parts, query) — CRUD for a shot's blocking, per ADR-002."
      },
      {
        "path": "backend/tests/previs-camera.test.js",
        "status": "built",
        "phase": 0,
        "why": "Optics against published values."
      },
      {
        "path": "backend/tests/previs-blocking.test.js",
        "status": "built",
        "phase": 1,
        "why": "Every movement sampled; every shot type solved for distance."
      },
      {
        "path": "backend/lib/scene-card-schema.js",
        "status": "modified",
        "phase": 1,
        "why": "camera gains sensor, aperture, focus_distance_m, height_m and an optional blocking reference. lens stays a string for compatibility."
      },
      {
        "path": "backend/lib/video-prompt.js",
        "status": "modified",
        "phase": 3,
        "why": "camera_control gains the sampled path when a shot has blocking, so previs reaches the generator instead of stopping at the diagram."
      },
      {
        "path": "backend/server.js",
        "status": "modified",
        "phase": 2,
        "why": "Dispatch the previs namespace."
      },
      {
        "path": "src/index.html",
        "status": "modified",
        "phase": 2,
        "why": "The viewer: stage view, camera view, inspector."
      },
      {
        "path": "backend/tests/previs-routes.test.js",
        "status": "built",
        "phase": 2,
        "why": "Routes dispatch, blocking round-trips, and the viewer stays a single file with no build step."
      },
      {
        "path": "backend/tests/previs-to-video.test.js",
        "status": "built",
        "phase": 3,
        "why": "Blocking reaches camera_control; unblocked shots stay byte-identical against a pre-phase-3 golden fixture."
      },
      {
        "path": "backend/lib/capability-payloads.js",
        "status": "modified",
        "phase": 3,
        "why": "loadShotContext carries ctx.previs so blocking travels the one payload path."
      }
    ],
    "migrations": [
      {
        "file": "058_previs_blocking.sql",
        "status": "applied",
        "phase": 2
      }
    ],
    "routes": [
      {
        "method": "GET",
        "path": "/film/shots/:id/previs",
        "phase": 2
      },
      {
        "method": "PUT",
        "path": "/film/shots/:id/previs",
        "phase": 2
      },
      {
        "method": "DELETE",
        "path": "/film/shots/:id/previs",
        "phase": 2
      },
      {
        "method": "POST",
        "path": "/film/shots/:id/previs/solve",
        "phase": 2
      },
      {
        "method": "GET",
        "path": "/film/previs/taxonomy",
        "phase": 2
      },
      {
        "method": "POST",
        "path": "/film/shots/:id/previs/to-video",
        "phase": 3
      }
    ],
    "phases": [
      {
        "id": 0,
        "name": "Optics as pure functions",
        "exit": "For every sensor and every lens in the kit, computed horizontal FOV matches the published value within 0.1 degrees, and hyperfocal distance matches a reference table within 1 percent."
      },
      {
        "id": 1,
        "name": "Blocking as data",
        "exit": "Every one of the 18 movements samples to a keyframe path whose start and end transforms differ, except static; and every framing shot type solves to a camera distance that puts the declared subject height exactly in frame."
      },
      {
        "id": 2,
        "name": "The viewer",
        "exit": "A shot can be blocked, saved, reloaded and played back in the SPA with no new build step, and index.html remains deployable as a single file."
      },
      {
        "id": 3,
        "name": "Feed the generator",
        "exit": "A blocked shot produces a camera_control whose type equals the one CAMERA_CONTROL_MAP already sends for that movement, plus a sampled path; an unblocked shot produces byte-identical output to today."
      },
      {
        "id": 4,
        "name": "Real subjects",
        "exit": "A character with a generated .glb loads into the stage view as its actual mesh, and the shot still renders when the model is absent."
      }
    ],
    "statusMeaning": {
      "new": "planned, must not exist yet",
      "built": "landed; the phase that owns it is complete",
      "modified": "already on disk, this plan changes it",
      "applied": "migration is on disk and has run"
    },
    "openQuestions": [
      "solveShot frames against the SENSOR, but delivery crops it: a close-up solved for 0.45m of subject height delivers 0.25m once a 2.39:1 extraction is taken from a 1.33:1 Super 35 gate. The viewer now shows both numbers, but the solver should probably take the project's aspect ratio and solve for the DELIVERED height. That changes phase 1's exit criterion, so it is a decision rather than a fix."
    ]
  }
}
