{
  "$comment": "Proposed node palette for a Flows-style visual canvas in Film Engine. Research artifact accompanying docs/plans/flows-canvas-research.md. Coverage is enforced by backend/tests/flows-node-taxonomy.test.js, which iterates the live CAPABILITIES and PIPELINE_STEPS registries \u2014 add a capability or a pipeline step and this file must grow with it.",
  "version": 1,
  "covers": {
    "capabilities": 11,
    "pipeline_steps": 9
  },
  "port_types": [
    "text",
    "image",
    "video",
    "audio",
    "model3d",
    "subject",
    "timeline",
    "any"
  ],
  "nodes": [
    {
      "id": "in.prompt",
      "label": "Prompt",
      "kind": "input",
      "inputs": [],
      "outputs": [
        "text"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "none \u2014 literal value stored on the node",
      "notes": "The Flows 'T' node. Supports {{handlebars}} interpolation from upstream text ports so one flow can be re-run per shot."
    },
    {
      "id": "in.asset",
      "label": "Asset",
      "kind": "input",
      "inputs": [],
      "outputs": [
        "image",
        "video",
        "audio",
        "model3d"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "film_assets",
      "notes": "Drop an existing registered asset, or upload. Outputs whichever port matches its asset_type."
    },
    {
      "id": "in.subject",
      "label": "Subject Reference",
      "kind": "input",
      "inputs": [],
      "outputs": [
        "subject",
        "image"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "film_characters / film_locations / film_props + film_consistency_profiles",
      "notes": "Carries LoRA/TI tokens and reference images. This is Film Engine's differentiator over generic canvases: identity is a first-class port, not a re-pasted prompt."
    },
    {
      "id": "in.scene",
      "label": "Scene / Shot",
      "kind": "input",
      "inputs": [],
      "outputs": [
        "text",
        "subject"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "film_scenes / film_shots (scene_card_yaml)",
      "notes": "Binds a flow to story data. Iterating this node over a scene's shots is what makes a flow a production tool rather than a one-off."
    },
    {
      "id": "gen.llm",
      "label": "Text / LLM",
      "kind": "generator",
      "inputs": [
        "text"
      ],
      "outputs": [
        "text"
      ],
      "capabilities": [
        "llm"
      ],
      "pipeline_steps": [],
      "backed_by": "providers.resolve('llm') \u2192 /chat/intelligent"
    },
    {
      "id": "gen.image",
      "label": "Image",
      "kind": "generator",
      "inputs": [
        "text",
        "image",
        "subject"
      ],
      "outputs": [
        "image"
      ],
      "capabilities": [
        "image"
      ],
      "pipeline_steps": [
        "keyframe"
      ],
      "backed_by": "providers.resolve('image'); prompt via lib/storyboard-prompt.js"
    },
    {
      "id": "gen.video",
      "label": "Video",
      "kind": "generator",
      "inputs": [
        "text",
        "image",
        "subject"
      ],
      "outputs": [
        "video"
      ],
      "capabilities": [
        "video"
      ],
      "pipeline_steps": [
        "video"
      ],
      "backed_by": "providers.resolve('video'); payload via lib/video-prompt.js"
    },
    {
      "id": "gen.voice",
      "label": "Voice",
      "kind": "generator",
      "inputs": [
        "text",
        "subject"
      ],
      "outputs": [
        "audio"
      ],
      "capabilities": [
        "voice"
      ],
      "pipeline_steps": [
        "voice"
      ],
      "backed_by": "providers.resolve('voice'); payload via lib/dialogue-builder.js"
    },
    {
      "id": "gen.music",
      "label": "Music",
      "kind": "generator",
      "inputs": [
        "text"
      ],
      "outputs": [
        "audio"
      ],
      "capabilities": [
        "music"
      ],
      "pipeline_steps": [
        "music"
      ],
      "backed_by": "providers.resolve('music'); payload via lib/music-prompt.js"
    },
    {
      "id": "gen.sfx",
      "label": "Sound Effect",
      "kind": "generator",
      "inputs": [
        "text"
      ],
      "outputs": [
        "audio"
      ],
      "capabilities": [
        "sfx"
      ],
      "pipeline_steps": [
        "sfx"
      ],
      "backed_by": "providers.resolve('sfx')"
    },
    {
      "id": "gen.ambient",
      "label": "Ambient Bed",
      "kind": "generator",
      "inputs": [
        "text"
      ],
      "outputs": [
        "audio"
      ],
      "capabilities": [
        "ambient"
      ],
      "pipeline_steps": [
        "ambient"
      ],
      "backed_by": "providers.resolve('ambient')",
      "notes": "Emits a loopable bed plus bed_duration_s; the mix node tiles it. See buildAmbientPrompt/buildMixPayload."
    },
    {
      "id": "gen.lipsync",
      "label": "Lip-Sync",
      "kind": "generator",
      "inputs": [
        "video",
        "audio"
      ],
      "outputs": [
        "video"
      ],
      "capabilities": [
        "lipsync"
      ],
      "pipeline_steps": [
        "lipsync"
      ],
      "backed_by": "providers.resolve('lipsync')"
    },
    {
      "id": "gen.post",
      "label": "Post (Upscale / Restore / Grade)",
      "kind": "generator",
      "inputs": [
        "video",
        "image"
      ],
      "outputs": [
        "video",
        "image"
      ],
      "capabilities": [
        "post"
      ],
      "pipeline_steps": [
        "post"
      ],
      "backed_by": "providers.resolve('post') \u2192 /postprocess"
    },
    {
      "id": "gen.model3d",
      "label": "3D Model",
      "kind": "generator",
      "inputs": [
        "text",
        "image",
        "subject"
      ],
      "outputs": [
        "model3d"
      ],
      "capabilities": [
        "model3d"
      ],
      "pipeline_steps": [],
      "backed_by": "providers.resolve('model3d'); payload via lib/threed-prompt.js"
    },
    {
      "id": "gen.world",
      "label": "Spatial World",
      "kind": "generator",
      "inputs": [
        "text",
        "image",
        "subject"
      ],
      "outputs": [
        "model3d"
      ],
      "capabilities": [
        "world"
      ],
      "pipeline_steps": [],
      "backed_by": "providers.resolve('world'); payload via lib/providers/worldlabs.js",
      "notes": "A place a camera can stand in, reconstructed from a location's own plates. NOT gen.model3d: that turns one SUBJECT into a mesh, this turns a PLACE into somewhere to shoot."
    },
    {
      "id": "tf.mix",
      "label": "Audio Mix",
      "kind": "transform",
      "inputs": [
        "audio",
        "video"
      ],
      "outputs": [
        "audio"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "lib/audio-mixer.js (pure) \u2192 POST /shots/:id/audio/mix",
      "notes": "Dialogue/music/sfx/ambient lanes with ducking. Already a pure function, so it drops into a node executor unchanged. Collector: the named inputs accept several sources at once (a final mix takes music, sfx and ambient together), unlike every other port which carries exactly one value.",
      "multi_inputs": [
        "audio"
      ]
    },
    {
      "id": "tf.stitch",
      "label": "Stitch Clips",
      "kind": "transform",
      "inputs": [
        "video"
      ],
      "outputs": [
        "video"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "lib/video-stitcher.js \u2192 POST /shots/:id/video/stitch"
    },
    {
      "id": "tf.encode",
      "label": "Encode",
      "kind": "transform",
      "inputs": [
        "video"
      ],
      "outputs": [
        "video"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "POST /shots/:id/post/encode (ProRes / DNxHR)"
    },
    {
      "id": "tf.fanout",
      "label": "Variants",
      "kind": "transform",
      "inputs": [
        "any"
      ],
      "outputs": [
        "any"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "new \u2014 executor-level",
      "notes": "The 'Run in Parallel' primitive: N seeds / N prompt variants / N providers from one upstream node. Downstream nodes run once per branch."
    },
    {
      "id": "tf.select",
      "label": "Select / Compare",
      "kind": "transform",
      "inputs": [
        "any"
      ],
      "outputs": [
        "any"
      ],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "film_takes / film_selects + GET /shots/:id/versions/compare",
      "notes": "Human gate. Collapses a fanout back to one branch; a paused flow here is the A/B review that already exists in the SPA."
    },
    {
      "id": "out.assembly",
      "label": "Assembly",
      "kind": "output",
      "inputs": [
        "video",
        "audio"
      ],
      "outputs": [
        "timeline"
      ],
      "capabilities": [],
      "pipeline_steps": [
        "assembly"
      ],
      "backed_by": "routes/nle-export.js",
      "notes": "Terminal node of the existing 9-step pipeline; today executeStep() no-ops it and defers to the export endpoints. Collector: the named inputs accept several sources at once (a final mix takes music, sfx and ambient together), unlike every other port which carries exactly one value.",
      "multi_inputs": [
        "video",
        "audio"
      ]
    },
    {
      "id": "out.asset",
      "label": "Save Asset",
      "kind": "output",
      "inputs": [
        "image",
        "video",
        "audio",
        "model3d"
      ],
      "outputs": [],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "film_assets + lib/file-storage.js",
      "notes": "Writes the node result back into the registry so canvas output is indistinguishable from pipeline output \u2014 the single most important node for keeping the canvas from becoming a side channel."
    },
    {
      "id": "out.timeline",
      "label": "Export",
      "kind": "output",
      "inputs": [
        "timeline",
        "video"
      ],
      "outputs": [],
      "capabilities": [],
      "pipeline_steps": [],
      "backed_by": "lib/nle-export.js (FCPXML / EDL / Premiere XML)"
    }
  ]
}
